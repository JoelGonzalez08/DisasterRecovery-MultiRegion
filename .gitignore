# Ignorar directorios locales de inicialización
**/.terraform/*

# Ignorar archivos de estado y planes compilados de Terraform (Evita fugas de información)
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Ignorar logs de errores
crash.log
crash.*.log

# Ignorar caché y entornos de Python para Boto3/FastAPI
__pycache__/
*.py[cod]
.env
